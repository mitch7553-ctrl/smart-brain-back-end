# Use DATABASE_URL or individual database settings
DATABASE_URL=postgres://user:password@localhost:5432/smartbrain
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=user
# DATABASE_PASSWORD=password
# DATABASE_DB=smartbrain

PORT=3000
CLARIFAI_PAT=replace-with-your-token
CLARIFAI_USER_ID=clarifai
CLARIFAI_APP_ID=main

# Required: strong random secret (32+ characters), stable across restarts
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
